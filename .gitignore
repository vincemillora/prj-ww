# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# non-pnpm lockfiles (this project uses pnpm)
package-lock.json
yarn.lock
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local hand-drawn icon library (full sets). Only the icons the site actually
# references live under public/icons/hand_drawn/ and are committed; the rest
# stays here so icons can be swapped in locally without repo weight.
/public/icons/_library/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# impeccable review captures (screenshots produced during a design pass)
.impeccable/review/
